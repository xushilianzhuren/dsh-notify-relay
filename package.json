{
  "name": "dsh-notify-relay",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "手机信使：长任务完成/出错/需决策时主动推通知到手机（Server酱/Bark/Gotify） Phone messenger: proactive push on task completion, errors, or decisions.",
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent",
    "notification"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@antinomyhq/forge": "*"
  }
}
